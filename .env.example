# ==== DATABASE ====
# PostgreSQL connection string. Create the database first, e.g.:
#   sudo -u postgres createuser --pwprompt taskmanager
#   sudo -u postgres createdb -O taskmanager task_manager
DATABASE_URL="postgresql://taskmanager:password@localhost:5432/task_manager?schema=public"

# ==== AUTH ====
# Generate with: openssl rand -base64 32
JWT_SECRET="your_jwt_secret_here"

# ==== SEED ACCOUNTS ====
# Used only by `npm run db:seed` to create the two initial accounts.
OWNER_EMAIL="owner@example.com"
OWNER_NAME="Owner"
MEMBER_EMAIL="member@example.com"
MEMBER_NAME="Anggota"
SEED_PASSWORD="changeme123"

# ==== PUBLIC ====
NEXT_PUBLIC_APP_URL="http://localhost:3000"
